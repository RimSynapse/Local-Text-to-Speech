<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="GamePath.props" />

    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <AssemblyName>RimSynapseLocalTts</AssemblyName>
        <RootNamespace>RimSynapse.LocalTts</RootNamespace>
        <LangVersion>9.0</LangVersion>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <OutputPath>..\Assemblies\</OutputPath>
        <DebugType>none</DebugType>
        <!-- We never want NuGet runtime assets auto-dumped next to the build; the AfterBuild
             target below copies exactly the managed + native files the mod needs. -->
        <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <!-- RimWorld / Unity assemblies (not bundled — loaded at runtime) -->
    <ItemGroup>
        <Reference Include="Assembly-CSharp">
            <HintPath>$(RimWorldPath)\RimWorldWin64_Data\Managed\Assembly-CSharp.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine">
            <HintPath>$(RimWorldPath)\RimWorldWin64_Data\Managed\UnityEngine.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(RimWorldPath)\RimWorldWin64_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.IMGUIModule">
            <HintPath>$(RimWorldPath)\RimWorldWin64_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.TextRenderingModule">
            <HintPath>$(RimWorldPath)\RimWorldWin64_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <!-- AudioModule: AudioClip / AudioSource for the mod's own playback (replaces Core's
             AudioPlaybackManager). Loaded at runtime; not bundled. -->
        <Reference Include="UnityEngine.AudioModule">
            <HintPath>$(RimWorldPath)\RimWorldWin64_Data\Managed\UnityEngine.AudioModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="0Harmony">
            <HintPath>$(HarmonyPath)\0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <!-- Standalone: no RimSynapse Core reference. Core previously supplied SynapseLogger,
             AudioPlaybackManager, the GpuStats channel, and Newtonsoft.Json — all now replaced
             by in-mod equivalents (TtsLog, TtsAudioPlayer, CoreGpuBridge via reflection, and a
             hand-rolled vocab parser). Optional Core integration is bound at runtime by reflection. -->
    </ItemGroup>

    <!-- .NET Framework reference assemblies via NuGet (no system-wide targeting pack needed). -->
    <ItemGroup>
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <!-- ONNX Runtime with the DirectML execution provider. Compile-time reference only;
         the AfterBuild target copies the managed dll + native runtime into the mod. -->
    <ItemGroup>
        <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.20.1">
            <GeneratePathProperty>true</GeneratePathProperty>
            <ExcludeAssets>runtime</ExcludeAssets>
        </PackageReference>
        <!-- The managed assembly ships in the .Managed dependency package; referenced here so we
             have its path property for staging. -->
        <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.20.1">
            <GeneratePathProperty>true</GeneratePathProperty>
            <ExcludeAssets>runtime</ExcludeAssets>
        </PackageReference>
        <PackageReference Include="System.Memory" Version="4.5.5">
            <GeneratePathProperty>true</GeneratePathProperty>
            <ExcludeAssets>runtime</ExcludeAssets>
        </PackageReference>
        <PackageReference Include="System.Buffers" Version="4.5.1">
            <GeneratePathProperty>true</GeneratePathProperty>
            <ExcludeAssets>runtime</ExcludeAssets>
        </PackageReference>
        <PackageReference Include="System.Numerics.Vectors" Version="4.5.0">
            <GeneratePathProperty>true</GeneratePathProperty>
            <ExcludeAssets>runtime</ExcludeAssets>
        </PackageReference>
        <!-- These two were previously provided by RimSynapse Core; standalone Local TTS must
             bundle them itself, as the ONNX Runtime managed assembly depends on them. -->
        <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0">
            <GeneratePathProperty>true</GeneratePathProperty>
            <ExcludeAssets>runtime</ExcludeAssets>
        </PackageReference>
        <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.5.4">
            <GeneratePathProperty>true</GeneratePathProperty>
            <ExcludeAssets>runtime</ExcludeAssets>
        </PackageReference>
    </ItemGroup>

    <!--
        Stage runtime dependencies into the mod after every build:
          * Managed ONNX Runtime + System.* shims -> Assemblies\  (RimWorld loads these as mod content)
          * Native onnxruntime.dll / DirectML.dll  -> Resources\native\win-x64\  (LoadLibrary'd at startup;
            they must NOT sit in Assemblies\ or RimWorld would try to load them as managed mods)
    -->
    <Target Name="StageTtsRuntime" AfterTargets="Build">
        <PropertyGroup>
            <NativeDest>$(MSBuildProjectDirectory)\..\Resources\native\win-x64\</NativeDest>
            <AsmDest>$(MSBuildProjectDirectory)\..\Assemblies\</AsmDest>
        </PropertyGroup>
        <MakeDir Directories="$(NativeDest)" />
        <ItemGroup>
            <_OrtManaged Include="$(PkgMicrosoft_ML_OnnxRuntime_Managed)\lib\netstandard2.0\Microsoft.ML.OnnxRuntime.dll" />
            <_OrtNative Include="$(PkgMicrosoft_ML_OnnxRuntime_DirectML)\runtimes\win-x64\native\*.dll" />
            <_SysShims Include="$(PkgSystem_Memory)\lib\netstandard2.0\System.Memory.dll" />
            <_SysShims Include="$(PkgSystem_Buffers)\lib\netstandard2.0\System.Buffers.dll" />
            <_SysShims Include="$(PkgSystem_Numerics_Vectors)\lib\netstandard2.0\System.Numerics.Vectors.dll" />
            <_SysShims Include="$(PkgSystem_Runtime_CompilerServices_Unsafe)\lib\netstandard2.0\System.Runtime.CompilerServices.Unsafe.dll" />
            <_SysShims Include="$(PkgSystem_Threading_Tasks_Extensions)\lib\netstandard2.0\System.Threading.Tasks.Extensions.dll" />
        </ItemGroup>
        <Copy SourceFiles="@(_OrtManaged)" DestinationFolder="$(AsmDest)" SkipUnchangedFiles="true" />
        <Copy SourceFiles="@(_SysShims)" DestinationFolder="$(AsmDest)" SkipUnchangedFiles="true" />
        <Copy SourceFiles="@(_OrtNative)" DestinationFolder="$(NativeDest)" SkipUnchangedFiles="true" />
        <Message Importance="high" Text="[LocalTTS] Staged ONNX Runtime managed + native DirectML binaries into the mod." />
    </Target>

</Project>
